{
  "name": "questkit",
  "version": "0.1.22",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "description": "QuestKit — an embeddable gamification SDK built entirely on Cloudflare's developer platform.",
  "author": "Bosso <noreply@github.com> (https://github.com/ilGentEAcutoO)",
  "license": "MIT",
  "homepage": "https://github.com/ilGentEAcutoO/QuestKit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilGentEAcutoO/QuestKit.git"
  },
  "bugs": {
    "url": "https://github.com/ilGentEAcutoO/QuestKit/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.10.0",
    "@eslint-react/eslint-plugin": "^5.8.1",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.0",
    "typescript": "5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,jsx}": "eslint --fix"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": "^7.0.5",
      "http-proxy-agent": "^7.0.0",
      "ws@>=8.0.0 <8.20.1": "^8.20.1",
      "shell-quote": ">=1.9.0",
      "websocket-driver": ">=0.7.5",
      "hono": ">=4.12.25",
      "fast-uri": ">=3.1.5",
      "undici": ">=7.29.0",
      "postcss": ">=8.5.18",
      "brace-expansion": ">=5.0.7",
      "js-yaml": ">=4.3.0",
      "sharp": ">=0.35.0",
      "ws": ">=8.21.0",
      "form-data": ">=4.0.6",
      "vite": ">=7.3.5",
      "esbuild": ">=0.28.1",
      "svgo": ">=3.3.4",
      "webpack-dev-server": ">=5.2.6",
      "http-proxy-middleware": ">=2.0.10",
      "launch-editor": ">=2.14.1",
      "joi": ">=17.13.4",
      "uuid": ">=11.1.1",
      "body-parser": ">=1.20.6",
      "@babel/core": ">=7.29.6",
      "react-router": "7.18.2",
      "react-router-dom": "7.18.2",
      "@remix-run/router": ">=1.23.3"
    }
  }
}
